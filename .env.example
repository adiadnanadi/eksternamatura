# Kopiraj ovaj fajl u .env i prilagodi vrijednosti:  cp .env.example .env

# SQLite baza — fajl na disku (kreira se automatski)
DATABASE_URL="file:./db/custom.db"

# Tajni kljuc za potpisivanje JWT sesija — obavezno promijeni!
# Generisi novi:  openssl rand -base64 48
AUTH_SECRET="promijeni-me-nekim-dugim-nasumicnim-stringom"
