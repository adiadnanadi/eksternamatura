# Kopiraj ovaj fajl u .env i prilagodi vrijednosti:  cp .env.example .env

# Neon Postgres (free) — connection string uzmi iz neon.com dashboarda
# (ili za lokalni SQLite:  DATABASE_URL="file:./db/custom.db" u prisma/ folderu)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/DBNAME?sslmode=require"

# Tajni kljuc za potpisivanje JWT sesija — obavezno promijeni!
# Generisi novi:  openssl rand -base64 48
AUTH_SECRET="promijeni-me-nekim-dugim-nasumicnim-stringom"

# Ko sme na /admin (zarezom odvojeni email-ovi korisničkih naloga)
ADMIN_EMAILS="tvoj@email.com"

# Gmail SMTP za verifikacione emailove (anti-spam registracije).
# App password: Google Account → Security → 2-Step Verification → App passwords.
# Ako NIJE podešeno — registracija radi bez verifikacije (auto-verifikacija).
GMAIL_USER="tvoj@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
